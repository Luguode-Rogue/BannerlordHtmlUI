<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Version>0.44.0</Version>
    <TargetFrameworks>net472;net6</TargetFrameworks>
    <Platforms>x64</Platforms>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <LangVersion>10.0</LangVersion>
    <Nullable>enable</Nullable>
    <BuildForWindows>false</BuildForWindows>
    <BuildForWindowsStore>false</BuildForWindowsStore>
    <ModuleId>$(MSBuildProjectName)</ModuleId>
    <ModuleName>$(MSBuildProjectName)</ModuleName>
    <ModuleUrl></ModuleUrl>
    <GameFolder>$(BANNERLORD_GAME_DIR)</GameFolder>
    <GameBinariesFolder Condition="Exists('$(GameFolder)\bin\Win64_Shipping_Client\Bannerlord.exe')">Win64_Shipping_Client</GameBinariesFolder>
    <GameBinariesFolder Condition="Exists('$(GameFolder)\bin\Gaming.Desktop.x64_Shipping_Client\Bannerlord.exe')">Gaming.Desktop.x64_Shipping_Client</GameBinariesFolder>

    <!-- The installed Mod root is the module directory. Runtime binaries/resources live below bin\<game-binary-dir>. -->
    <ConsumerModuleDeployDir Condition="'$(ConsumerModuleDeployDir)' == ''">$(GameFolder)\Modules\$(ModuleId)</ConsumerModuleDeployDir>
    <ConsumerBinaryDeployDir Condition="'$(ConsumerBinaryDeployDir)' == ''">$(ConsumerModuleDeployDir)\bin\$(GameBinariesFolder)</ConsumerBinaryDeployDir>
    <ConsumerUiSourceDir Condition="'$(ConsumerUiSourceDir)' == ''">$(MSBuildProjectDirectory)\UI</ConsumerUiSourceDir>
    <ConsumerUiDeployDir Condition="'$(ConsumerUiDeployDir)' == ''">$(ConsumerBinaryDeployDir)\UI</ConsumerUiDeployDir>
    <ConsumerModuleDataSourceDir Condition="'$(ConsumerModuleDataSourceDir)' == ''">$(MSBuildProjectDirectory)\ModuleData</ConsumerModuleDataSourceDir>
    <ConsumerModuleDataDeployDir Condition="'$(ConsumerModuleDataDeployDir)' == ''">$(ConsumerModuleDeployDir)\ModuleData</ConsumerModuleDataDeployDir>
  </PropertyGroup>

  <PropertyGroup Condition="$(TargetFramework) == 'net472'">
    <BuildForWindows>true</BuildForWindows>
  </PropertyGroup>
  <PropertyGroup Condition="$(TargetFramework) == 'net6'">
    <BuildForWindowsStore>true</BuildForWindowsStore>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="$(GameFolder)\bin\$(GameBinariesFolder)\Newtonsoft.Json.dll">
      <HintPath>%(Identity)</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="$(GameFolder)\bin\$(GameBinariesFolder)\TaleWorlds.*.dll" Exclude="$(GameFolder)\bin\$(GameBinariesFolder)\TaleWorlds.Native.dll">
      <HintPath>%(Identity)</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="$(GameFolder)\Modules\Native\bin\$(GameBinariesFolder)\*.dll">
      <HintPath>%(Identity)</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="$(GameFolder)\Modules\SandBox\bin\$(GameBinariesFolder)\*.dll">
      <HintPath>%(Identity)</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="$(GameFolder)\Modules\SandBoxCore\bin\$(GameBinariesFolder)\*.dll">
      <HintPath>%(Identity)</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="$(GameFolder)\Modules\StoryMode\bin\$(GameBinariesFolder)\*.dll">
      <HintPath>%(Identity)</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="$(GameFolder)\Modules\CustomBattle\bin\$(GameBinariesFolder)\*.dll">
      <HintPath>%(Identity)</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="$(GameFolder)\Modules\BirthAndDeath\bin\$(GameBinariesFolder)\*.dll">
      <HintPath>%(Identity)</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="BannerlordHtmlUI">
      <HintPath>$(GameFolder)\Modules\BannerlordHtmlUI\bin\Win64_Shipping_Client\BannerlordHtmlUI.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Nullable" Version="1.3.1" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
    <PackageReference Include="IsExternalInit" Version="1.0.3" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
    <PackageReference Include="Bannerlord.BuildResources" Version="1.1.0.124" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
    <PackageReference Include="Lib.Harmony" Version="2.3.3" IncludeAssets="compile" />
    <PackageReference Include="Harmony.Extensions" Version="3.2.0.77" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
    <PackageReference Include="BUTR.Harmony.Analyzer" Version="1.0.1.50" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
  </ItemGroup>

  <!-- Keep the repository project files in the source tree. Deployment is handled explicitly below. -->
  <ItemGroup>
    <None Include="_Module\SubModule.xml" />
    <None Include="UI\**\*" />
    <None Include="ModuleData\**\*" />
  </ItemGroup>

  <!--
    Runtime deployment layout:
      Modules\HtmlUiConsumerTestMod\
        SubModule.xml
        ModuleData\...
        bin\Win64_Shipping_Client\
          HtmlUiConsumerTestMod.dll
          UI\...

    The game's loaded assembly lives in bin\<GameBinariesFolder>, and the Consumer runtime
    resolves its UI root from the directory containing that assembly.
  -->
  <Target Name="DeployConsumerRuntimeAssets"
          AfterTargets="Build"
          Condition="'$(TargetFramework)' == 'net472' and '$(DesignTimeBuild)' != 'true' and Exists('$(GameFolder)') and Exists('$(GameBinariesFolder)')">
    <Message Importance="High" Text="[BannerlordHtmlUI] Consumer runtime module: '$(ConsumerModuleDeployDir)'" />
    <Message Importance="High" Text="[BannerlordHtmlUI] Consumer binary directory: '$(ConsumerBinaryDeployDir)'" />
    <Message Importance="High" Text="[BannerlordHtmlUI] Deploy UI: '$(ConsumerUiSourceDir)' -> '$(ConsumerUiDeployDir)'" />
    <Message Importance="High" Text="[BannerlordHtmlUI] Deploy ModuleData: '$(ConsumerModuleDataSourceDir)' -> '$(ConsumerModuleDataDeployDir)'" />

    <MakeDir Directories="$(ConsumerModuleDeployDir);$(ConsumerBinaryDeployDir);$(ConsumerUiDeployDir);$(ConsumerModuleDataDeployDir)" />

    <ItemGroup>
      <_ConsumerUiFiles Include="$(ConsumerUiSourceDir)\**\*" />
      <_ConsumerModuleDataFiles Include="$(ConsumerModuleDataSourceDir)\**\*" />
    </ItemGroup>

    <Copy
      SourceFiles="@(_ConsumerUiFiles)"
      DestinationFiles="@(_ConsumerUiFiles->'$(ConsumerUiDeployDir)\%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />

    <Copy
      SourceFiles="@(_ConsumerModuleDataFiles)"
      DestinationFiles="@(_ConsumerModuleDataFiles->'$(ConsumerModuleDataDeployDir)\%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />

    <Copy
      SourceFiles="$(MSBuildProjectDirectory)\_Module\SubModule.xml"
      DestinationFiles="$(ConsumerModuleDeployDir)\SubModule.xml"
      SkipUnchangedFiles="true" />
  </Target>

</Project>
